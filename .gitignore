# Virtual environments
.venv/
venv/
env/

# Sensitive API keys & secrets
**/.env
**/*.env
!**/.env.example

# Python cache & bytecode
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so

# ChromaDB & SQLite databases
**/data/chromadb/
**/*.sqlite3

